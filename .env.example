# ===================================================================
# Personal Developer Command Centre - Cloud Environment Configuration
# ===================================================================

# 1. Owner Account Identity & Security
OWNER_EMAIL=karthik@example.com
OWNER_NAME=Karthik

# 2. Resend API Key for 2FA Verification & Dynamic Password Emails
# Get your free key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Command Centre <onboarding@resend.dev>

# 3. Database Configuration (Auto-provided by Render PostgreSQL)
DB_URL=jdbc:postgresql://<render_db_host>:5432/<render_db_name>
DB_USERNAME=<render_db_user>
DB_PASSWORD=<render_db_password>

# 4. Session & Security Policies
SESSION_TIMEOUT_HOURS=24
OTP_EXPIRY_MINUTES=2
OTP_MAX_ATTEMPTS=5

# 5. AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
